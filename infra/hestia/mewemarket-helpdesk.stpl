#=========================================================================#
# MeweMarket Helpdesk (Chatwoot) — HestiaCP nginx PROXY template, HTTPS (443)
# chat.mewemarket.com -> the Chatwoot container. /api/hosted-sso goes to MeweMarket
# (127.0.0.1:35300): it signs people in by setting Chatwoot's session
# cookie on this host. Chatwoot forbids framing, so its frame header is
# replaced with one that lets mewemarket.com embed it.
# Setup: docs/DEPLOY.md, "Hosted apps".
#   v-add-web-domain saasthemes chat.mewemarket.com
#   v-change-web-domain-proxy-tpl saasthemes chat.mewemarket.com mewemarket-helpdesk
#=========================================================================#

server {
    listen      %ip%:%proxy_ssl_port% ssl;
    http2       on;
    server_name %domain_idn% %alias_idn%;
    error_log   /var/log/%web_system%/domains/%domain%.error.log error;

    ssl_certificate      %ssl_pem%;
    ssl_certificate_key  %ssl_key%;

    include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;
    client_max_body_size 50m;

    location ~ /\.(?!well-known\/) {
        deny all;
        return 404;
    }

    # Sign-in bridge: served by MeweMarket on this host.
    location = /api/hosted-sso {
        limit_req          zone=mewe_hosted burst=300 nodelay;
        limit_conn         mewe_conn 60;
        proxy_pass         http://127.0.0.1:35300;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req          zone=mewe_hosted burst=300 nodelay;
        limit_conn         mewe_conn 60;
        proxy_pass         http://127.0.0.1:3240;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 1h;
        # Let mewemarket.com (only) show this app in a frame.
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  Content-Security-Policy;
        add_header         Content-Security-Policy "frame-ancestors 'self' https://mewemarket.com" always;
    }

    # The product's own sign-in endpoints: MeweMarket signs people in from the server (not through here).
    location ~ "^/(auth/|app/login|api/v1/profile/password|super_admin)" {
        limit_req          zone=mewe_auth burst=5 nodelay;
        proxy_pass         http://127.0.0.1:3240;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_hide_header  X-Frame-Options;
    }

    location ~ "^/(widget|public/api/|api/v1/widget/|hc/)" {
        limit_req          zone=mewe_public burst=30 nodelay;
        limit_conn         mewe_conn 30;
        proxy_pass         http://127.0.0.1:3240;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_hide_header  X-Frame-Options;
    }

    location /error/ {
        alias %home%/%user%/web/%domain%/document_errors/;
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
