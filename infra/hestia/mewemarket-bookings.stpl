#=========================================================================#
# MeweMarket Bookings (Easy!Appointments) — HestiaCP nginx PROXY template, HTTPS (443)
# book.mewemarket.com -> the Easy!Appointments container. /api/hosted-sso goes to MeweMarket
# (127.0.0.1:35300): it signs people in by setting Easy!Appointments's session
# cookie on this host. Easy!Appointments forbids framing, so its frame header is
# replaced with one that lets mewemarket.com embed it.
# Setup: docs/DEPLOY.md, "Hosted apps".
#   (needs infra/hestia/mewemarket-maps.conf in /etc/nginx/conf.d/)
#   v-add-web-domain saasthemes book.mewemarket.com
#   v-change-web-domain-proxy-tpl saasthemes book.mewemarket.com mewemarket-bookings
#=========================================================================#

server {
    listen      %ip%:%proxy_ssl_port% ssl;
    http2       on;
    server_name %domain_idn% %alias_idn%;
    error_log   /var/log/%web_system%/domains/%domain%.error.log error;

    ssl_certificate      %ssl_pem%;
    ssl_certificate_key  %ssl_key%;

    include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;
    client_max_body_size 20m;

    location ~ /\.(?!well-known\/) {
        deny all;
        return 404;
    }

    # Sign-in bridge: served by MeweMarket on this host.
    location = /api/hosted-sso {
        limit_req          zone=mewe_hosted burst=300 nodelay;
        limit_conn         mewe_conn 60;
        proxy_pass         http://127.0.0.1:35300;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }


    # Each company: /{company}/ -> the Easy!Appointments container, prefix stripped, company named, with the
    # shared secret (from mewemarket-maps.conf) so the container trusts the name. Company names can't be "api".
    location ~ "^/[a-z0-9][a-z0-9-]{0,40}$" {
        absolute_redirect off;
        return 301 $uri/$is_args$args;
    }
    # Submitting a booking (anonymous visitors): at most 20 a minute per visitor, so bots can't fill a calendar.
    location ~ "^/(?<ea_tenant>[a-z0-9][a-z0-9-]{0,40})(?<ea_rest>/index\.php/booking/register.*)$" {
        limit_req          zone=mewe_send burst=5 nodelay;
        proxy_pass         http://127.0.0.1:3260$ea_rest$is_args$args;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Ea-Tenant       $ea_tenant;
        proxy_set_header   X-Ea-Proxy-Key    $mewe_ea_proxy_key;
        proxy_set_header   X-Platform-Key    "";
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  Content-Security-Policy;
        add_header         Content-Security-Policy "frame-ancestors 'self' https://mewemarket.com" always;
    }
    location ~ "^/(?<ea_tenant>[a-z0-9][a-z0-9-]{0,40})(?<ea_rest>/.*)$" {
        limit_req          zone=mewe_public burst=60 nodelay;
        limit_conn         mewe_conn 30;
        proxy_pass         http://127.0.0.1:3260$ea_rest$is_args$args;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Ea-Tenant       $ea_tenant;
        proxy_set_header   X-Ea-Proxy-Key    $mewe_ea_proxy_key;
        proxy_set_header   X-Platform-Key    "";
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Let mewemarket.com (only) show it in a frame.
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  Content-Security-Policy;
        add_header         Content-Security-Policy "frame-ancestors 'self' https://mewemarket.com" always;
    }

    location / {
        return 404;
    }

    location /error/ {
        alias %home%/%user%/web/%domain%/document_errors/;
    }

    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
