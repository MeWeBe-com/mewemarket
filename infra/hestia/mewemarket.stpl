#=========================================================================#
# MeweMarket — HestiaCP nginx PROXY template, HTTPS (port 443)            #
# Proxies everything to the Next.js app run by PM2 as "mewemarket" on     #
# 127.0.0.1:35300. Copy to /usr/local/hestia/data/templates/web/nginx/    #
# and apply to mewemarket.com only:                                       #
#   v-change-web-domain-proxy-tpl saasthemes mewemarket.com mewemarket    #
# Roll back: v-change-web-domain-proxy-tpl saasthemes mewemarket.com default
#=========================================================================#

server {
    listen      %ip%:%proxy_ssl_port% ssl;
    http2       on;
    server_name %domain_idn% %alias_idn%;
    error_log   /var/log/%web_system%/domains/%domain%.error.log error;

    ssl_certificate      %ssl_pem%;
    ssl_certificate_key  %ssl_key%;

    include %home%/%user%/conf/web/%domain%/nginx.hsts.conf*;

    client_max_body_size 20m;

    location ~ /\.(?!well-known\/) {
        deny all;
        return 404;
    }

    # Bookings: each company's public booking page and staff screens live at /{company}/book/, served by the
    # Easy!Appointments container with the prefix stripped and the company named (needs mewemarket-maps.conf).
    # Site sections with sub-pages are skipped (companies can't use those names: RESERVED_SLUGS).
    location ~ "^/(?!(?:apps|tools|insights|api|w|account|products|category|users|invite|_next)/)[a-z0-9][a-z0-9-]{0,40}/book$" {
        absolute_redirect off;
        return 301 $uri/$is_args$args;
    }
    location ~ "^/(?!(?:apps|tools|insights|api|w|account|products|category|users|invite|_next)/)(?<ea_tenant>[a-z0-9][a-z0-9-]{0,40})/book(?<ea_rest>/.*)$" {
        limit_req          zone=mewe_public burst=60 nodelay;
        limit_conn         mewe_conn 30;
        proxy_pass         http://127.0.0.1:3260$ea_rest$is_args$args;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Ea-Tenant       $ea_tenant;
        proxy_set_header   X-Ea-Proxy-Key    $mewe_ea_proxy_key;
        proxy_set_header   X-Platform-Key    "";
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
    }

    location /_next/static/ {
        proxy_pass         http://127.0.0.1:35300;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        expires            365d;
        add_header         Cache-Control "public, max-age=31536000, immutable";
        access_log         off;
    }

    # Video-meeting signalling is a long-lived event stream: no buffering, long timeouts.
    location /api/meet/ {
        proxy_pass         http://127.0.0.1:35300;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_buffering    off;
        proxy_cache        off;
        gzip               off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass         http://127.0.0.1:35300;
        proxy_set_header   Accept-Encoding   "";
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering    on;
    }

    location /error/ {
        alias %home%/%user%/web/%domain%/document_errors/;
    }

    # Per-domain includes: Let's Encrypt, and the mewebe-seo insights block (/insights/, llms.txt, verification files).
    include %home%/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
