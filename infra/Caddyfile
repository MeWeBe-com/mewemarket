# Copy to /etc/caddy/Caddyfile, then: systemctl reload caddy
www.mewemarket.com {
	redir https://mewemarket.com{uri} permanent
}

mewemarket.com {
	# Compress everything except the meeting event streams, which must flush every message.
	@compressible not path /api/meet/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		-Server
	}

	# Video meetings keep an event stream open per participant; don't buffer it.
	handle /api/meet/* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Hosted CRM (Twenty): every company's CRM is <company>.crm.mewemarket.com. A wildcard certificate needs
# the DNS challenge, so Caddy must be built with your DNS provider's module (e.g. caddy-dns/cloudflare)
# and given its API token. Twenty sets its own frame headers, so nothing is rewritten here.
crm.mewemarket.com, *.crm.mewemarket.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip
	header -Server
	reverse_proxy 127.0.0.1:3200
}

# Hosted apps on their own hosts. /api/hosted-sso is MeweMarket's sign-in bridge (it sets the app's session
# cookie on the app's host). The apps forbid framing, so the frame header is replaced to allow mewemarket.com.
(hosted_frame) {
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' https://mewemarket.com"
		-Server
		defer
	}
	reverse_proxy /api/hosted-sso 127.0.0.1:3000
}

invoices.mewemarket.com {
	import hosted_frame
	encode zstd gzip
	reverse_proxy 127.0.0.1:3210
}

chat.mewemarket.com {
	import hosted_frame
	encode zstd gzip
	reverse_proxy 127.0.0.1:3240
}

plane.mewemarket.com {
	import hosted_frame
	encode zstd gzip
	# Only MeweMarket creates workspaces (it calls Plane's API directly, not through here).
	@createWorkspace {
		method POST
		path /api/workspaces/
	}
	respond @createWorkspace 403
	reverse_proxy /god-mode/* 127.0.0.1:3232
	reverse_proxy /spaces/* 127.0.0.1:3233
	reverse_proxy /live/* 127.0.0.1:3234
	reverse_proxy /api/* 127.0.0.1:3230
	reverse_proxy /auth/* 127.0.0.1:3230
	reverse_proxy /static/* 127.0.0.1:3230
	reverse_proxy /plane-uploads/* 127.0.0.1:9000
	reverse_proxy 127.0.0.1:3231
}

# Documenso's CSP has a per-request nonce, so only its frame-ancestors directive is rewritten.
sign.mewemarket.com {
	header >Content-Security-Policy "frame-ancestors 'self'" "frame-ancestors 'self' https://mewemarket.com"
	header -Server
	reverse_proxy /api/hosted-sso 127.0.0.1:3000
	encode zstd gzip
	reverse_proxy 127.0.0.1:3250
}

# Bookings (Easy!Appointments) on its own origin: https://book.mewemarket.com/{company}/ (MeweMarket shows it at
# mewemarket.com/{company}/book). The company is named for the container with the prefix stripped.
book.mewemarket.com {
	import hosted_frame
	encode zstd gzip
	@ea path_regexp ea ^/([a-z0-9][a-z0-9-]{0,40})(/.*)?$
	handle @ea {
		rewrite * {re.ea.2}?{query}
		reverse_proxy 127.0.0.1:3260 {
			header_up X-Ea-Tenant {re.ea.1}
			header_up X-Ea-Proxy-Key {env.EA_PROXY_KEY}
			header_up -X-Platform-Key
		}
	}
	respond 404
}

# AI Chat (Open WebUI). Its user directory endpoints list every user on the server, so they're refused.
ai.mewemarket.com {
	import hosted_frame
	encode zstd gzip
	@directory path_regexp ^/api/v1/users/(search|[^/]+/info)
	respond @directory 403
	reverse_proxy 127.0.0.1:3270
}
