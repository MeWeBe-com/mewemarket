{
  "name": "mewemarket",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mewe/db generate",
    "db:migrate": "pnpm --filter @mewe/db migrate"
  },
  "devDependencies": { "turbo": "^2.5.0", "typescript": "^5.9.0" }
}
