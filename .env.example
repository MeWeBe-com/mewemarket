# --- Core ---
NODE_ENV=production
APP_URL=https://mewemarket.com
PORT=3000
# 32+ random bytes, base64: openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_KEY=

# --- Database / cache ---
DATABASE_URL=postgres://mewe:CHANGE_ME@127.0.0.1:5432/mewemarket
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (MinIO) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mewemarket
S3_ACCESS_KEY=mewe
S3_SECRET_KEY=CHANGE_ME

# --- Stripe (secret key + webhook signing secret; no publishable key needed) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Email (SMTP). Leave SMTP_HOST empty to log mail instead of sending it. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MeweMarket <hello@mewemarket.com>"

# --- Insights articles (folder the mewebe-seo pipeline publishes into; served at /insights/) ---
INSIGHTS_DIR=

# --- Hosted CRM (Twenty) ---
# Public base address; each company's CRM is <company>.<this host>. Needs a wildcard DNS record and certificate.
TWENTY_URL=https://crm.mewemarket.com
# Where this server reaches Twenty directly (docker-compose maps it to 127.0.0.1:3200).
TWENTY_INTERNAL_URL=http://127.0.0.1:3200
# 32+ random bytes: openssl rand -hex 32. Never change it after the first start.
TWENTY_APP_SECRET=
# MeweMarket's own admin account inside Twenty, created on first use. Use a long random password.
TWENTY_PLATFORM_EMAIL=platform@mewemarket.com
TWENTY_PLATFORM_PASSWORD=
# Optional: Twenty Enterprise key, needed once more than 5 companies use the CRM.
TWENTY_ENTERPRISE_KEY=

# --- Hosted Invoices (InvoiceShelf) ---
INVOICESHELF_URL=https://invoices.mewemarket.com
INVOICESHELF_HOST=invoices.mewemarket.com
INVOICESHELF_INTERNAL_URL=http://127.0.0.1:3210
# "base64:" + openssl rand -base64 32. Never change it after the first start.
INVOICESHELF_APP_KEY=
INVOICESHELF_PLATFORM_EMAIL=platform@mewemarket.com
INVOICESHELF_PLATFORM_PASSWORD=

# --- Hosted Helpdesk (Chatwoot) ---
CHATWOOT_URL=https://chat.mewemarket.com
CHATWOOT_INTERNAL_URL=http://127.0.0.1:3240
# openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=
# Platform-app token, printed by the setup command in docs/DEPLOY.md.
CHATWOOT_PLATFORM_TOKEN=

# --- Hosted Projects (Plane) ---
PLANE_URL=https://plane.mewemarket.com
# Plane's API container directly (workspace creation is blocked on the public proxy).
PLANE_INTERNAL_URL=http://127.0.0.1:3230
# openssl rand -hex 32
PLANE_SECRET_KEY=
# Plane's instance admin, created by the setup steps in docs/DEPLOY.md.
PLANE_PLATFORM_EMAIL=platform@mewemarket.com
PLANE_PLATFORM_PASSWORD=

# --- Hosted E-Signatures (Documenso) ---
DOCUMENSO_URL=https://sign.mewemarket.com
DOCUMENSO_INTERNAL_URL=http://127.0.0.1:3250
# Each: openssl rand -hex 32. Never change the encryption keys after the first start.
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=
# Passphrase of infra/documenso/cert.p12 (the certificate that seals signed PDFs).
DOCUMENSO_SIGNING_PASSPHRASE=
DOCUMENSO_PLATFORM_EMAIL=platform@mewemarket.com
DOCUMENSO_PLATFORM_PASSWORD=
# Read-only role on Documenso's "PasswordResetToken" table (created by infra/hosted-setup.sh).
DOCUMENSO_DATABASE_URL=postgres://documenso_reader:CHANGE_ME@127.0.0.1:5432/documenso

# --- Hosted Bookings (Easy!Appointments) ---
# Its own origin (never the main site's): companies at EA_URL/{company}/, shown at APP_URL/{company}/book.
EA_URL=https://book.mewemarket.com
EA_INTERNAL_URL=http://127.0.0.1:3260
# Each: openssl rand -hex 32. EA_PLATFORM_KEY is MeweMarket's; EA_PROXY_KEY is the reverse proxy's (also set it
# in infra/hestia/mewemarket-maps.conf or the Caddyfile). They must differ.
EA_PLATFORM_KEY=
EA_PROXY_KEY=
EA_DB_ROOT_PASSWORD=

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CONTACT_INBOX=hello@mewemarket.com
