# --- Core ---
NODE_ENV=production
APP_URL=https://mewemarket.com
PORT=3000
# 32+ random bytes, base64: openssl rand -base64 32
AUTH_SECRET=
ENCRYPTION_KEY=

# --- Database / cache ---
DATABASE_URL=postgres://mewe:CHANGE_ME@127.0.0.1:5432/mewemarket
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (MinIO) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mewemarket
S3_ACCESS_KEY=mewe
S3_SECRET_KEY=CHANGE_ME

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="MeweMarket <hello@mewemarket.com>"

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
